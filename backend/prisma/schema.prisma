generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id        String   @id @default(uuid())
  name      String
  phone     String
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  updatedAt DateTime @updatedAt

  plants Plant[]
}

model Plant {
  id           String   @id @default(uuid())
  name         String
  categoryId   String
  vendorPrice  Float
  retailPrice  Float?
  currentStock Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id])

  issueItems         IssueItem[]
  returnItems        ReturnItem[]
  inventoryMovements InventoryMovement[]
}

model Session {
  id        String        @id @default(uuid())
  vendorId  String
  status    SessionStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  closedAt  DateTime?
  notes     String?
  createdBy String?
  closedBy  String?

  vendor Vendor @relation(fields: [vendorId], references: [id])

  issueItems    IssueItem[]
  returnItems   ReturnItem[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  inventoryMovements InventoryMovement[]
}

model IssueItem {
  id        String   @id @default(uuid())
  sessionId String
  plantId   String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?

  session Session @relation(fields: [sessionId], references: [id])
  plant   Plant   @relation(fields: [plantId], references: [id])
}

model ReturnItem {
  id        String   @id @default(uuid())
  sessionId String
  plantId   String
  quantity  Int
  condition PlantCondition
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?

  session Session @relation(fields: [sessionId], references: [id])
  plant   Plant   @relation(fields: [plantId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  vendorId  String
  sessionId String?
  amount    Float
  mode      PaymentMode
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     String?

  vendor  Vendor  @relation(fields: [vendorId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])
}

model LedgerEntry {
  id        String          @id @default(uuid())
  vendorId  String
  sessionId String?
  type      LedgerEntryType
  amount    Float
  notes     String?
  createdBy String?
  createdAt DateTime        @default(now())

  vendor  Vendor   @relation(fields: [vendorId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([vendorId, createdAt])
  @@index([sessionId])
  @@index([type, createdAt])
}

model InventoryMovement {
  id        String                @id @default(uuid())
  itemId    String
  sessionId String?
  type      InventoryMovementType
  quantity  Int
  notes     String?
  createdBy String?
  createdAt DateTime              @default(now())

  plant   Plant    @relation(fields: [itemId], references: [id])
  session Session? @relation(fields: [sessionId], references: [id])

  @@index([itemId, createdAt])
  @@index([sessionId])
  @@index([type, createdAt])
}

model IdempotencyRecord {
  id        String                  @id @default(uuid())
  requestId String                  @unique
  operation IdempotentOperationType
  response  Json?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@index([operation, createdAt])
}

enum Role {
  ADMIN
  STAFF
}

enum SessionStatus {
  DRAFT
  ACTIVE
  CLOSED
  SETTLED
}

enum PaymentMode {
  CASH
  UPI
}

enum PlantCondition {
  GOOD
  DAMAGED
}

enum LedgerEntryType {
  SESSION_DUE
  PAYMENT_RECEIVED
  BALANCE_ADJUSTMENT
  REFUND
  MANUAL_CORRECTION
}

enum InventoryMovementType {
  ISSUE_OUT
  RETURN_IN
  DAMAGE
  ADJUSTMENT
  PURCHASE
}

enum IdempotentOperationType {
  ISSUE_ITEMS
  RETURN_ITEMS
  SESSION_CLOSE
  PAYMENT_CREATE
  INVENTORY_ADJUSTMENT
}
