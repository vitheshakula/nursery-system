# --- Database (Neon PostgreSQL) ---
# Pooled (PgBouncer) connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection — used by Prisma Migrate. Same host without "-pooler".
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth (JWT access + refresh) ---
JWT_ACCESS_SECRET="replace-with-a-strong-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-strong-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000
